{
  "$schema": "./foundations.schema.json",
  "version": "0.20.0",
  "status": "living",
  "layer": "methods",
  "prompt": "opt-in",
  "principle": "Everything in an interface should serve a purpose.",
  "content": {
    "default": "direct and informative",
    "styleRule": "Additional style is used only when it communicates something.",
    "purposeRequired": true,
    "capitalizationAndPunctuation": {
      "topLevelTitleCase": true,
      "properNounsFollowGrammar": true,
      "interfaceHeadings": {
        "case": "sentence",
        "closingPunctuation": false
      },
      "bodyCopy": {
        "case": "sentence",
        "terminalPeriod": true
      },
      "interactiveLabels": {
        "terminalPeriod": false,
        "modalContinuation": "...",
        "punctuationLikeGlyphsAllowed": ["chevron", "arrow"],
        "questionMarkUse": "rare; help or support"
      },
      "exclamationPoints": "almost never"
    }
  },
  "process": {
    "personalTasteAsScaffolding": {
      "purpose": "Reduce decision load by providing meaningful starting constraints.",
      "examples": ["pet font", "animation style", "music", "personal history"],
      "mustYieldToContext": true
    },
    "humanJudgment": {
      "principle": "Mathematical systems are tools and imprecise representations of human perception.",
      "feeling": "Question how something feels, but do not discard the feeling.",
      "contextFactors": ["display characteristics", "human perception", "surrounding content", "cultural context"],
      "designFor": "people"
    }
  },
  "typography": {
    "preferredBaseSizesPx": [16, 17],
    "defaultBaseSizePx": 17,
    "scale": {
      "name": "major-second",
      "ratio": 1.125,
      "stepsBelow": 3,
      "stepsAbove": 6,
      "roundedSizesAt17Px": [12, 13, 15, 17, 19, 22, 24, 27, 31, 34]
    },
    "tracking": {
      "assumesOpticalSizing": false,
      "renderedSizeFormula": "round(base * 1.125^step)",
      "rawDifferenceDivisor": 3,
      "rawPercentFormula": "(base - renderedSize) / 3",
      "taperType": "cubic-soft-limit",
      "taperLimitPercent": 6,
      "taperExponent": 3,
      "taperedPercentFormula": "rawPercent / cbrt(1 + (abs(rawPercent) / 6)^3)",
      "defaultShiftPercent": 0,
      "allCapsAdditionalPercent": 4,
      "defaultManualAdjustmentPercent": 0,
      "trackingFormula": "trackingShift + taperedPercent + allCapsAdjustment + manualAdjustment",
      "cssEmFormula": "trackingPercent / 100",
      "baseBehavior": "Tracking equals trackingShift when renderedSize equals base.",
      "sizeDirection": {
        "belowBase": "positive tracking",
        "aboveBase": "negative tracking"
      },
      "manualAdjustment": "Apply per role after calculation when the rendered font requires correction.",
      "visualReviewRequired": true
    },
    "responsiveType": {
      "input": "current computed font size in pixels",
      "recalculateOn": ["initial render", "font load", "responsive size change"],
      "trackingBehavior": "Recalculate the tracking curve from the current rendered size.",
      "lineHeight": {
        "rawFormula": "renderedSize * lineHeightRatio",
        "gridThresholdPx": 20,
        "gridAtOrBelowThresholdPx": 2,
        "gridAboveThresholdPx": 4,
        "gridFormula": "renderedSize > 20 ? 4 : 2",
        "snappedFormula": "round(rawLineHeightPx / lineHeightGridPx) * lineHeightGridPx",
        "manualAdjustmentAppliedLast": true
      },
      "visualReviewRequired": true
    },
    "weightRoles": {
      "bodyAndContent": "regular",
      "headerStartingPoint": "medium",
      "opticalCorrection": "medium",
      "interactiveStartingPoint": "semibold",
      "buttonLabelMinimum": "medium",
      "reversedButtonLabelMinimum": "semibold",
      "strongAttention": "bold",
      "midStringChangeOnlyFor": "interactivity",
      "adaptTo": ["design system", "brand", "typeface"]
    },
    "opticalAdjustmentAllowed": true
  },
  "color": {
    "space": "oklch",
    "grayScale": {
      "stops": [0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950, 1000],
      "white": {
        "stop": 0,
        "oklch": [1, 0, 0],
        "pureWhite": true
      },
      "black": {
        "stop": 1000,
        "nameDescribesRole": true,
        "pureBlack": false,
        "defaultLightness": 0.05
      },
      "curveInput": "stop / 1000",
      "lightnessByStop": {
        "0": 1,
        "50": 0.97098,
        "100": 0.93812,
        "200": 0.86065,
        "300": 0.76845,
        "400": 0.66472,
        "500": 0.55453,
        "600": 0.4433,
        "700": 0.33532,
        "800": 0.23316,
        "900": 0.13798,
        "950": 0.0931,
        "1000": 0.05
      },
      "documentationUsage": {
        "pageBackground": 0,
        "inverseText": 0,
        "subtlePanel": 50,
        "border": 100,
        "strongBorder": 300,
        "mutedText": 600,
        "primaryText": 1000,
        "darkSurface": 1000
      },
      "perceptualReviewRequired": true
    },
    "grayScaleCurve": {
      "type": "cubic-bezier",
      "controlPoints": {
        "x1": 0.35,
        "y1": 0.2,
        "x2": 0.55,
        "y2": 0.6
      },
      "note": "A useful starting point; customize when context requires it."
    },
    "colorScales": {
      "sharesGrayScaleStops": true,
      "sharesGrayScaleEndpoints": true,
      "sharesGrayScaleLightness": false,
      "hueConstantPerScale": true,
      "peakChroma": 0.16,
      "gamut": "srgb",
      "gamutClampFraction": 0.95,
      "curveInput": "stop / 1000",
      "lightnessCurve": {
        "type": "cubic-bezier",
        "controlPoints": {
          "x1": 0.5,
          "y1": 0.3,
          "x2": 0.6,
          "y2": 0.5
        },
        "note": "Shared by all six saturated scales. Holds midtones lighter than the gray curve because sRGB chroma peaks near L 0.6 to 0.75."
      },
      "lightnessByStop": {
        "0": 1,
        "50": 0.97103,
        "100": 0.94102,
        "200": 0.87712,
        "300": 0.80638,
        "400": 0.72628,
        "500": 0.63419,
        "600": 0.52906,
        "700": 0.41332,
        "800": 0.29211,
        "900": 0.17012,
        "950": 0.10973,
        "1000": 0.05
      },
      "chromaArch": {
        "type": "cubic-bezier",
        "from": [0, 0],
        "to": [1, 0],
        "controlPoints": {
          "x1": 0.3333,
          "y1": 1.3333,
          "x2": 0.6667,
          "y2": 1.3333
        },
        "evaluatesTo": "4 * t * (1 - t)"
      },
      "chromaFormula": "min(peakChroma * 4 * t * (1 - t), gamutClampFraction * maxSrgbChroma(lightness, hue))",
      "scales": {
        "blue": {
          "hue": 250,
          "chromaByStop": { "0": 0, "50": 0.0135, "100": 0.0278, "200": 0.0594, "300": 0.0962, "400": 0.1403, "500": 0.16, "600": 0.1423, "700": 0.1111, "800": 0.0786, "900": 0.0458, "950": 0.0295, "1000": 0 }
        },
        "red": {
          "hue": 28,
          "chromaByStop": { "0": 0, "50": 0.0135, "100": 0.0282, "200": 0.0621, "300": 0.1047, "400": 0.1536, "500": 0.16, "600": 0.1536, "700": 0.1344, "800": 0.1024, "900": 0.0576, "950": 0.0304, "1000": 0 }
        },
        "orange": {
          "hue": 65,
          "chromaByStop": { "0": 0, "50": 0.0182, "100": 0.0378, "200": 0.0825, "300": 0.1344, "400": 0.1536, "500": 0.1352, "600": 0.1128, "700": 0.0881, "800": 0.0623, "900": 0.0363, "950": 0.0234, "1000": 0 }
        },
        "yellow": {
          "hue": 100,
          "chromaByStop": { "0": 0, "50": 0.0304, "100": 0.0576, "200": 0.1024, "300": 0.1344, "400": 0.1434, "500": 0.1253, "600": 0.1045, "700": 0.0816, "800": 0.0577, "900": 0.0336, "950": 0.0217, "1000": 0 }
        },
        "purple": {
          "hue": 305,
          "chromaByStop": { "0": 0, "50": 0.0162, "100": 0.0333, "200": 0.0713, "300": 0.1159, "400": 0.1536, "500": 0.16, "600": 0.1536, "700": 0.1344, "800": 0.1024, "900": 0.0576, "950": 0.0304, "1000": 0 }
        },
        "green": {
          "hue": 145,
          "chromaByStop": { "0": 0, "50": 0.0304, "100": 0.0576, "200": 0.1024, "300": 0.1344, "400": 0.1536, "500": 0.16, "600": 0.1536, "700": 0.1235, "800": 0.0873, "900": 0.0508, "950": 0.0304, "1000": 0 }
        }
      },
      "perceptualReviewRequired": true
    }
  },
  "layout": {
    "gridPx": 2,
    "largeSpacingThresholdPx": 20,
    "largeSpacingGridPx": 4,
    "spacingLadder": {
      "px": [1, 2, 4, 6, 8, 10, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64, 80, 96, 112, 128],
      "stepBands": [
        { "stepPx": 2, "throughPx": 12 },
        { "stepPx": 4, "throughPx": 32 },
        { "stepPx": 8, "throughPx": 64 },
        { "stepPx": 16, "throughPx": 128 }
      ],
      "extendRule": "Continue doubling the step past 128.",
      "hairlinePx": 1,
      "hairlineUse": "Borders, dividers, and optical nudges; not layout spacing.",
      "offLadderValues": "Recorded optical corrections on the grid only."
    },
    "opticalCompensation": true,
    "rhythm": {
      "standardizeFirst": true,
      "elements": ["baselines", "grids", "tokens", "type sizes", "spacing", "repeated structures"]
    },
    "swing": {
      "definition": "A limited, purposeful break from an established rhythm.",
      "purposes": ["interrupt monotony", "restore attention", "communicate importance or change"],
      "appliesAcross": ["layout", "typography", "color", "motion"],
      "reasonRequired": true
    }
  },
  "interface": {
    "controlSizes": {
      "mouse": {
        "preferredBaseHeightsPx": [24, 28],
        "powerUserBaseHeightPx": 24,
        "consumerBaseHeightPx": 28,
        "comfortableMinimumHeightPx": 20,
        "necessaryMinimumHeightPx": 16,
        "aboveDefaultUseSparingly": true,
        "largeControlExamples": ["highlighted input", "marketing action", "onboarding action"],
        "largeSearchRequiresSingleVisibleSearch": true
      },
      "touch": {
        "minimumTargetSizePx": 44,
        "minimumVisibleInteractiveAffordancePx": 24,
        "visibleAffordanceMayBeSmallerThanTarget": true,
        "exampleLargeSizesPx": [64, 72],
        "hardMaximumSizePx": null,
        "adjacentTargetsMustRemainDistinct": true,
        "overlappingTargetsAllowed": false
      }
    },
    "cornerRadii": {
      "basis": "personal taste",
      "scale": {
        "px": [0, 1, 2, 4, 6, 8, 10, 12, 16, 20, 24, 28, 32],
        "stepBands": [
          { "stepPx": 2, "throughPx": 12 },
          { "stepPx": 4, "throughPx": 32 }
        ],
        "extendRule": "Continue doubling the step past 32: 40, 48, 56, 64.",
        "endpoints": {
          "square": 0,
          "full": "Arbitrarily large radius; resolves to half the element's smaller dimension for pills and circles."
        },
        "nestedInnerRadiiMayLeaveScale": true
      },
      "nestedFormula": "innerRadiusPx = outerRadiusPx - insetPx",
      "example": {
        "outerRadiusPx": 32,
        "insetPx": 20,
        "calculatedInnerRadiusPx": 12,
        "acceptableOpticalAdjustmentPx": 16
      },
      "containerGenerallyRounderThanContent": true,
      "largeOuterRadiiRequireMoreConcentricity": true,
      "smallRadiiAllowLooserMatching": true,
      "opticalAdjustmentAllowed": true
    }
  },
  "motion": {
    "web": {
      "typicalMaximumDurationMs": 200,
      "character": "exceptionally snappy"
    },
    "touch": {
      "character": "slower and more fluid when direct manipulation benefits"
    },
    "complexAnimationScaffold": {
      "framesPerSecond": 60,
      "loopFrames": 48,
      "loopSeconds": 0.8,
      "loopMilliseconds": 800,
      "equivalentTempoBpm": 75,
      "subdivisionFrames": 12,
      "subdivisionSeconds": 0.2,
      "subdivisionMilliseconds": 200,
      "oneFrameMilliseconds": 16.667,
      "swing": "Move selected internal keyframes earlier or later while preserving the 48-frame loop."
    },
    "reducedMotionRequired": true
  }
}
