        "950": 0.0931,
        "1000": 0.05
      },
      "documentationUsage": {
        "pageBackground": 0,
        "inverseText": 0,
        "subtlePanel": 50,
        "border": 100,
        "strongBorder": 300,
        "mutedText": 600,
        "primaryText": 1000,
        "darkSurface": 1000,
        "diagramAccent": "blue 500; diagrams only, interface chrome stays pure gray"
      },
      "perceptualReviewRequired": true
    },
    "grayScaleCurve": {
      "type": "cubic-bezier",
      "controlPoints": {
        "x1": 0.35,
        "y1": 0.2,
        "x2": 0.55,
        "y2": 0.6
      },
      "note": "A useful starting point; customize when context requires it."
    },
    "colorScales": {
      "sharesGrayScaleStops": true,
      "sharesGrayScaleEndpoints": true,
      "sharesGrayScaleLightness": false,
      "hueConstantPerScale": true,
      "peakChroma": 0.16,
      "gamut": "srgb",
      "gamutClampFraction": 0.95,
      "curveInput": "stop / 1000",
      "lightnessCurve": {
        "type": "cubic-bezier",
        "controlPoints": {
          "x1": 0.5,
          "y1": 0.3,
          "x2": 0.6,
          "y2": 0.5
        },
        "note": "Shared by all six saturated scales. Holds midtones lighter than the gray curve because sRGB chroma peaks near L 0.6 to 0.75."
      },
      "lightnessByStop": {
        "0": 1,
        "50": 0.97103,
        "100": 0.94102,
        "200": 0.87712,
        "300": 0.80638,
        "400": 0.72628,
        "500": 0.63419,
        "600": 0.52906,
        "700": 0.41332,
        "800": 0.29211,
        "900": 0.17012,
        "950": 0.10973,
        "1000": 0.05
      },
      "chromaArch": {
        "type": "cubic-bezier",
        "from": [
          0,
          0
        ],
        "to": [
          1,
          0
