  "layout": {
    "gridPx": 2,
    "largeSpacingThresholdPx": 20,
    "largeSpacingGridPx": 4,
    "spacingLadder": {
      "px": [
        1,
        2,
        4,
        6,
        8,
        10,
        12,
        16,
        20,
        24,
        28,
        32,
        40,
        48,
        56,
        64,
        80,
        96,
        112,
        128
      ],
      "stepBands": [
        {
          "stepPx": 2,
          "throughPx": 12
        },
        {
          "stepPx": 4,
          "throughPx": 32
        },
        {
          "stepPx": 8,
          "throughPx": 64
        },
        {
          "stepPx": 16,
          "throughPx": 128
        }
      ],
      "extendRule": "Continue doubling the step past 128.",
      "hairlinePx": 1,
      "hairlineUse": "Borders, dividers, and optical nudges; not layout spacing.",
      "offLadderValues": "Recorded optical corrections on the grid only."
    },
    "opticalCompensation": true,
    "rhythm": {
      "standardizeFirst": true,
      "elements": [
        "baselines",
        "grids",
        "tokens",
        "type sizes",
        "spacing",
        "repeated structures"
      ]
    },
    "swing": {
      "definition": "A limited, purposeful break from an established rhythm.",
      "purposes": [
        "interrupt monotony",
        "restore attention",
        "communicate importance or change"
      ],
      "appliesAcross": [
        "layout",
        "typography",
        "color",
        "motion"
      ],
      "reasonRequired": true
    }
  },
  "interface": {
    "controlSizes": {
      "mouse": {
        "preferredBaseHeightsPx": [
          24,
          28
        ],
        "powerUserBaseHeightPx": 24,
        "consumerBaseHeightPx": 28,
        "comfortableMinimumHeightPx": 20,
        "necessaryMinimumHeightPx": 16,
        "aboveDefaultUseSparingly": true,
        "largeControlExamples": [
          "highlighted input",
          "marketing action",
          "onboarding action"
        ],
        "largeSearchRequiresSingleVisibleSearch": true
      },
      "touch": {
        "minimumTargetSizePx": 44,
        "minimumVisibleInteractiveAffordancePx": 24,
        "visibleAffordanceMayBeSmallerThanTarget": true,
        "exampleLargeSizesPx": [
          64,
          72
        ],
        "hardMaximumSizePx": null,
        "adjacentTargetsMustRemainDistinct": true,
        "overlappingTargetsAllowed": false
      }
    },
    "cornerRadii": {
      "basis": "personal taste",
      "scale": {
        "px": [
          0,
          1,
          2,
          4,
          6,
          8,
          10,
          12,
          16,
          20,
          24,
          28,
          32
        ],
        "stepBands": [
          {
            "stepPx": 2,
            "throughPx": 12
          },
          {
            "stepPx": 4,
            "throughPx": 32
          }
        ],
        "extendRule": "Continue doubling the step past 32: 40, 48, 56, 64.",
        "endpoints": {
          "square": 0,
          "full": "Arbitrarily large radius; resolves to half the element's smaller dimension for pills and circles."
        },
        "nestedInnerRadiiMayLeaveScale": true
      },
      "nestedFormula": "innerRadiusPx = outerRadiusPx - insetPx",
      "example": {
        "outerRadiusPx": 32,
        "insetPx": 20,
        "calculatedInnerRadiusPx": 12,
        "acceptableOpticalAdjustmentPx": 16
      },
      "containerGenerallyRounderThanContent": true,
      "largeOuterRadiiRequireMoreConcentricity": true,
      "smallRadiiAllowLooserMatching": true,
      "opticalAdjustmentAllowed": true
    },
    "buttons": {
      "sizesPx": {
        "xs": 24,
        "s": 32,
        "m": 40,
        "l": 48,
        "xl": 56
      },
      "sizeNaming": "t-shirt",
      "sizeRangeIsAlarm": "Needing a size outside the t-shirt range signals too many sizes.",
      "styles": {
        "primary": "highlight color",
        "secondary": "gray",
        "tertiary": "outlined or text only"
      },
      "styleRangeIsAlarm": "Needing a Quaternary style signals too many styles.",
      "onePrimaryPerSurface": true,
      "webDesktopNudging": "Heights are nudged per screen on web and desktop; a nudge changes a role's value, never adds a role.",
      "referByName": "Sizes are referred to by name, never numeric value, so the values stay free to change."
    },
    "scrim": {
      "term": "Scrim, from theater: a translucent layer laid over the background content.",
      "overlay": {
        "color": "white",
        "opacityPercent": 20
      },
      "implementation": "One overlay element; the content beneath renders untouched.",
      "pairsWithShadow": true,
      "drawnFrom": "color.transparentScales.alphaWhiteByStop",
      "note": "Slight by design; the content beneath stays legible and reads as inactive, not removed."
    }
  },
  "imagery": {
    "iconography": {
      "sizesPx": {
        "workhorse": 20,
        "sprinkled": [
          16,
          24
        ],
        "rare": [
          12,
          32
        ]
      },
      "frequencyTaper": "The further a size sits from the workhorse, the less often it should appear.",
      "textPairingsPx": {
        "20": 16
      },
      "pairingRule": "One icon size per text size, held consistent everywhere it appears.",
      "chevronArrowException": "Chevrons and arrows completing a phrase are tuned optically against the text and may leave the pairing."
