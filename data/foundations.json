    "transparentScales": {
      "basis": "Generated alongside the gray scale; blacks are built from gray 1000, never pure black.",
      "compositingSpace": "gamma-encoded sRGB, as browsers composite rgba",
      "alphaWhiteFormula": "(s(stop) - s(1000)) / (1 - s(1000))",
      "alphaBlackFormula": "(1 - s(stop)) / (1 - s(1000))",
      "alphasSumToOne": true,
      "alphaWhiteByStop": {
